[Unit]
Description=ChiCha Website test environment
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f chicha-website-test
ExecStartPre=/usr/bin/docker pull node:22-alpine
ExecStart=/usr/bin/docker run --rm --name chicha-website-test --network none --publish 127.0.0.1:3100:3100 --volume /data/www/chicha-website-test:/app:ro --env HOST=0.0.0.0 --env PORT=3100 node:22-alpine node /app/serve.mjs
ExecStop=/usr/bin/docker stop --time 15 chicha-website-test

[Install]
WantedBy=multi-user.target
